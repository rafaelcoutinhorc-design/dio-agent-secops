# LABORATÓRIO: configuração PROPOSITALMENTE INSEGURA do servidor SSH (OpenSSH)
# para a skill secure-code-review (cenário de infraestrutura). Não use em produção.
Port 22
ListenAddress 0.0.0.0

PermitRootLogin yes
PasswordAuthentication yes
PermitEmptyPasswords yes
PubkeyAuthentication yes
KbdInteractiveAuthentication yes

MaxAuthTries 10
LoginGraceTime 5m
MaxSessions 50

X11Forwarding yes
AllowTcpForwarding yes
GatewayPorts yes
PermitTunnel yes

ClientAliveInterval 0
LogLevel QUIET

Ciphers aes128-cbc,3des-cbc,aes256-ctr
MACs hmac-md5,hmac-sha1

Subsystem sftp /usr/lib/openssh/sftp-server
