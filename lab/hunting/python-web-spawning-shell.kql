// Hipótese: se o /ping do lab/app.py sofrer command injection, o processo python
//           vai gerar um shell (cmd/sh) que executa comandos de reconhecimento.
// MITRE ATT&CK: T1190 (Exploit Public-Facing Application), T1059.003 / T1059.004
// ISO/IEC 27001:2022: 8.16 Atividades de monitoramento  |  NIST CSF 2.0: DE.CM, DE.AE
// Falso positivo esperado: o próprio ping legítimo, que o código vulnerável executa
//           via "cmd.exe /c ping ..." (Windows) ou "sh -c ping ..." (Linux). Filtrado abaixo
//           somente quando a linha de comando NÃO tem separadores (&, |, ;, $, `).
//           Depois da correção (shell=False), qualquer shell filho do python é sinal forte.
let ShellsEFerramentas = dynamic(["cmd.exe","powershell.exe","pwsh.exe","sh","bash","dash",
    "whoami.exe","whoami","net.exe","ipconfig.exe","curl.exe","curl","wget","certutil.exe"]);
DeviceProcessEvents
| where Timestamp > ago(7d)
| where InitiatingProcessFileName in~ ("python.exe","python3.exe","pythonw.exe","python","python3")
     or InitiatingProcessParentFileName in~ ("python.exe","python3.exe","python","python3")
| where FileName in~ (ShellsEFerramentas)
| where not(ProcessCommandLine matches regex @'(?i)^("?\S*(cmd(\.exe)?|sh)"?\s+(/c|-c)\s+"?)?\S*ping(\.exe)?\s+-[nc]\s+1\s+[\w\.\-]+"?\s*$')
| project Timestamp, DeviceId, DeviceName, AccountName, ReportId,
          InitiatingProcessFileName, InitiatingProcessCommandLine,
          FileName, ProcessCommandLine
| order by Timestamp desc
